# Copy this file to .env (local) or set these in your Vercel project settings.

# From your Zernio dashboard, after signing up and connecting
# GemRishi's Instagram, Facebook Page, and WhatsApp Business number.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Google Gemini API key (aistudio.google.com) — powers the reply engine.
# Free tier, no credit card required.
GEMINI_API_KEY=

# The Google Apps Script Web App URL from apps-script-webhook.gs
# (leave blank to just log to console instead of a sheet, for testing).
LEAD_LOG_WEBHOOK_URL=
