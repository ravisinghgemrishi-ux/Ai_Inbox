# Local development / Vercel environment variable names only. Never commit secret values.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LEAD_LOG_WEBHOOK_URL=

# Phase 2: verified GemRishi product-search API endpoint.
# Supports either a URL containing {query} or a normal endpoint that accepts ?q=...
GEMRISH_PRODUCT_API_URL=

# Upstash Redis REST credentials used for duplicate protection and conversation memory.
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=
# Legacy aliases supported by the current handler:
REDIS_URL=
REDIS_K_TOKEN=

# Optional Phase 2 human-alert relays. These receive the same JSON escalation payload.
# Keep these unset until the team's approved email and WhatsApp relay endpoints are ready.
ESCALATION_EMAIL_WEBHOOK_URL=
ESCALATION_WHATSAPP_WEBHOOK_URL=

# Mannat AI 2.0 - Kundli-guided gemstone/Rudraksha flow (lib/kundliFlow.js).
# Leave ENABLE_KUNDLI_FLOW unset/false until this has been reviewed and
# tested - the flow is fully wired but completely inert until it's "true".
ENABLE_KUNDLI_FLOW=
# Points at the separate gemrishi-astrology-engine Vercel project. Only
# override for a staging copy of that engine.
ASTROLOGY_ENGINE_URL=
# Checkout-enabled Shopify domain used to build product cart links.
# TODO(Ravi): confirm this is correct before enabling the flow.
GEMRISH_SHOPIFY_DOMAIN=rudraksha.gemrishi.com
# JSON object of consultation plan payment links, e.g.
# {"gemstone_consultation": {"label": "Gemstone Consultation", "url": "https://..."}}
# TODO(Ravi): this is not filled in yet - the flow works without it, but
# can't offer a consultation payment link until this is set.
GEMRISH_CONSULTATION_PLANS=
