# Local development / Vercel environment variable names only. Never commit secret values.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LEAD_LOG_WEBHOOK_URL=

# Phase 2: verified GemRishi product-search API endpoint.
# Supports either a URL containing {query} or a normal endpoint that accepts ?q=...
GEMRISH_PRODUCT_API_URL=

# Upstash Redis REST credentials used for duplicate protection and conversation memory.
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=
# Legacy aliases supported by the current handler:
REDIS_URL=
REDIS_K_TOKEN=

# Optional Phase 2 human-alert relays. These receive the same JSON escalation payload.
# Keep these unset until the team's approved email and WhatsApp relay endpoints are ready.
ESCALATION_EMAIL_WEBHOOK_URL=
ESCALATION_WHATSAPP_WEBHOOK_URL=
